              "value": "{\"cedula\":\"0102030405\",\"fechaCita\":\"20/11/2026\",\"horaInicio\":\"3:30 PM\",\"horaFin\":\"4:00 PM\",\"tipoCita\":\"Consulta\",\"motivo\":\"Dolor dental\",\"observacion\":\"\"}"
