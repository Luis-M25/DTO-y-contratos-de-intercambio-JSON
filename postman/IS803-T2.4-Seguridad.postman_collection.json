            "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiNGQxMTExMTgtNGQxMi00MzlhLWEwZWYtZTBlY2VlZTQ1ZTQ1IiwidXNlcl9vZmYOklcOiJkYXRlIjoiTWFpbiBBbG9uZyIsImV4cGlyZXNfdXNlcmluZyI3NDQ5MjU0MDAuMDAwMDAwMCSJ9.DEMO_TOKEN_PLACEHOLDER4",
