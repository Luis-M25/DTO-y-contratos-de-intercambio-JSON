  "item": [
    {
      "name": "T4-P1-Login-Doctora",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "json",
          "json": [
            {
              "id": "email",
              "type": "text",
              "value": "{{demo_doctor_email}}"
            },
            {
              "id": "password",
              "type": "text",
              "value": "{{demo_doctor_password}}"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has token\", function () {",
              "  pm.response.json().data.token && pm.response.to.not.be.null;",
              "});",
              "",
              "pm.test(\"Role is doctora\", function () {",
              "  pm.response.json().data.user.role && pm.response.json().data.user.role === 'doctora';",
              "});"
            ]
          }
        }
      ]
    },
    {
