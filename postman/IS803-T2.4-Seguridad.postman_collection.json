        "description": "Asistente importando cita desde origen A"
      },
      "event": [
        {
          "listen": "test",
          "script": [
            "pm.test(\"Status code is 201\", function () {",
            "  pm.response.to.have.status(201);",
            "});",
            "pm.test(\"Data has correct fields\", function () {",
            "  var json = pm.response.json();",
            "  pm.expect(json.data).to.have.property('paciente_id');",
            "  pm.expect(json.data).to.have.property('fecha');",
            "  pm.expect(json.data).to.have.property('hora_inicio');",
            "  pm.expect(json.data).to.have.property('hora_fin');",
            "  pm.expect(json.data).to.have.property('tipo');",
            "  pm.expect(json.data).to.have.property('motivo');",
            "  pm.expect(json.data).to.have.property('canal');",
            "  pm.expect(json.data.canal).to.equal('web');",
            "});"
          ]
