    {
      "name": "T4-P5-Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ1c2VyX2lkIjoiNGQxMTExMTgtNGQxMi00MzlhLWEwZWYtZTBlY2VlZTQ1ZTQ1IiwidXNlcl9vZmYOklcOiJkYXRlIjoiTWFpbiBBbG9uZyIsImV4cGlyZXNfdXNlcmluZyI3NDQ5MjU0MDAuMDAwMDAwMCSJ9.DEMO_TOKEN_PLACEHOLDER3",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/auth/logout",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "auth",
            "logout"
          ]
        },
        "description": "Cerrar sesión y revocar token"
      },
      "event": [
        {
          "listen": "test",
          "script": [
            "pm.test(\"Status code is 200\", function () {",
            "  pm.response.to.have.status(200);",
            "});",
              "pm.test(\"Token invalidado\", function () {",
            "  pm.response.json().message && pm.response.to.have.property('message');",
            "});",
              "pm.request.to.deleteHeaders(\"Authorization\");",
              "pm.sendRequest({",
              "  url: \"{{base_url}}/api/v1/auth/me\",",
              "  method: 'GET'",
              "}).then(function (resp) {",
              "  pm.test(\"Me returns 401 after logout\", function () {",
              "    resp.to.have.status(401);",
              "  });",
              "});"
            ]
          ]
        }
      ]
    },
    {
      "name": "T4-P6-Importar-Asistente",
      "request": {
