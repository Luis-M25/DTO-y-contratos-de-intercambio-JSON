  "item": [
    {
      "name": "00 - Listar pacientes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Lista de pacientes disponible', function () {",
              "    pm.expect(json.data).to.be.an('array').that.is.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('paciente_id', json.data[0].paciente_id);",
              "pm.environment.set('paciente_id', json.data[0].paciente_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/pacientes",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "pacientes"
          ]
        }
      }
    },
    {
      "name": "P1 - Solicitud valida",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Contrato de respuesta', function () {",
              "    pm.expect(json).to.have.property('data');",
              "    pm.expect(json.data).to.include.keys('solicitud_id', 'paciente_id', 'fecha', 'hora_inicio', 'hora_fin', 'tipo', 'canal', 'estado', 'creado_en');",
              "    pm.expect(json.data.estado).to.eql('pendiente');",
              "    pm.expect(json.data.fecha).to.eql('2026-11-20');",
              "    pm.expect(json.data.hora_inicio).to.eql('09:30');",
              "    pm.expect(json.data.hora_fin).to.eql('10:00');",
              "});",
              "",
              "pm.collectionVariables.set('solicitud_id', json.data.solicitud_id);",
              "pm.environment.set('solicitud_id', json.data.solicitud_id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paciente_id\": \"{{paciente_id}}\",\n  \"fecha\": \"2026-11-20\",\n  \"hora_inicio\": \"09:30\",\n  \"hora_fin\": \"10:00\",\n  \"tipo\": \"consulta\",\n  \"motivo\": \"Dolor dental\",\n  \"canal\": \"web\",\n  \"observacion\": \"Primera consulta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/solicitudes-cita",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "solicitudes-cita"
          ]
        }
      }
    },
