APP_NAME="IS803 T2.2 API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

# Autenticación y seguridad
SANCTUM_EXPIRATION=1440
SANCTUM_TOKEN_PREFIX=is803_

# Credenciales de demostración: complete los valores en su .env local (nunca los versione)
DEMO_DOCTORA_EMAIL=doctora@demo.test
DEMO_DOCTORA_PASSWORD=
DEMO_ASISTENTE_EMAIL=asistente@demo.test
DEMO_ASISTENTE_PASSWORD=
DEMO_PACIENTE_A_EMAIL=paciente.a@demo.test
DEMO_PACIENTE_A_PASSWORD=
DEMO_PACIENTE_B_EMAIL=paciente.b@demo.test
DEMO_PACIENTE_B_PASSWORD=

# Base de datos
DB_CONNECTION=sqlite

# Correo
MAIL_MAILER=log